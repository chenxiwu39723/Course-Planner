# 複製本檔為 .env 後填入實際值。.env 已列入 .gitignore，金鑰只存在後端。
# 沒有金鑰的組員：把 LLM_PROVIDER 設為 mock，即可跑完整流程（以關鍵字規則產生確定性結果）。

# 語言模型供應商：azure_openai（預設）或 mock
LLM_PROVIDER=azure_openai

# Azure OpenAI 設定（LLM_PROVIDER=azure_openai 時需要）
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# 語意搜尋 embeddings（階段 4）：預設用本機 sentence-transformers，免 API。
# 設為 azure 可改用 Azure OpenAI embeddings（需另設 deployment）。
EMBEDDING_PROVIDER=local

# 資料來源：live（實際抓取結果，預設）或 sample（虛構，無 courses.json 時用）
# 註：找不到 data/courses.json 時會自動退回 sample，不會當掉。
DATA_SOURCE=live

# 網站埠號（階段 5）
PORT=5001
